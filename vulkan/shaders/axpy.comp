#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputA {
    float values[];
} input_a;

layout(set = 0, binding = 1, std430) readonly buffer InputB {
    float values[];
} input_b;

layout(set = 0, binding = 2, std430) writeonly buffer Output {
    float values[];
} output_c;

layout(push_constant) uniform Parameters {
    uint count;
    float alpha;
} parameters;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < parameters.count) {
        output_c.values[index] =
            parameters.alpha * input_a.values[index] + input_b.values[index];
    }
}

